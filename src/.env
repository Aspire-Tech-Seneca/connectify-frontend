# Base URL for your local development server
REACT_APP_BASE_URL=http://localhost

# Base API path for your backend endpoints
REACT_APP_BASE_PATH=/api

# Azure Blob Storage Base URL for images (publicly accessible container)
REACT_APP_BLOB_STORAGE_BASE_URL=https://atcdevstorageaccount.blob.core.windows.net/atcdevstoragecontainer/

# SAS Token for Azure Blob Storage (ensure it starts with a '?' character)
REACT_APP_BLOB_SAS_TOKEN=?sv=yourSASTokenHere
