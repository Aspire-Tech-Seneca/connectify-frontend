# Base URL for your local development server
REACT_APP_BASE_URL=http://172.190.212.74:8000

# Base API path for your backend endpoints
REACT_APP_BASE_PATH=/api

# Azure Blob Storage Base URL for images (publicly accessible container)
REACT_APP_BLOB_STORAGE_BASE_URL=https://atcdevsa.blob.core.windows.net/media/
REACT_APP_BLOB_STORAGE_EVENT_IMAGES=https://atcdevsa.blob.core.windows.net/media/event_images/
REACT_APP_BLOB_STORAGE_GALLERY_IMAGES=https://atcdevsa.blob.core.windows.net/media/gallery_images/


# SAS Token for Azure Blob Storage (ensure it starts with a '?' character)
REACT_APP_BLOB_SAS_TOKEN=?sv=yourSASTokenHere